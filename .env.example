# --- App ---
ENVIRONMENT=
NEXT_PUBLIC_SITE_URL=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=

# --- AI providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
EXA_API_KEY=

# --- Stripe ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Backend services ---
CLAUDE_AGENT_SERVICE_URL=
NEXT_PUBLIC_COMPILE_SERVICE_URL=
COMPILE_SERVICE_URL=
COMPILE_SERVICE_URL_STAGING=
COMPILE_SERVICE_AUTH_TOKEN=

# --- Email ---
RESEND_API_KEY=
# Signs unsubscribe links (lifecycle emails fall back to CRON_SECRET when unset).
EMAIL_UNSUBSCRIBE_SECRET=
# Lifecycle cron (app/api/cron/lifecycle): limit_hit, pro_inactive and
# warm_lead_offer are on by default (warm_lead_offer off with `false`).
# welcome and day7 are paused and the win-back email to lapsed payers is off;
# each only goes out with `true`.
LIFECYCLE_WELCOME_ENABLED=
LIFECYCLE_DAY7_ENABLED=
LIFECYCLE_WINBACK_ENABLED=
LIFECYCLE_WARM_LEAD_OFFER_ENABLED=

# --- Ops (cron routes in app/api/cron) ---
# Vercel sends this as `Authorization: Bearer` on cron invocations.
CRON_SECRET=
# Owner inbox for the daily digest and uptime alerts. Unset = no email sent.
OPS_ALERT_EMAIL=

# --- PostHog ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- Reddit ---
REDDIT_CAPI_ACCESS_TOKEN=
