# Supabase project JWT secret. Required in production: /compile and /synctex
# accept only HS256 tokens signed with it whose role is "authenticated" (a
# user's access token) or "service_role" (the service-role key). The public
# anon key is rejected. Leave unset only for local development (auth off).
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Optional: pin user tokens to one Supabase project, e.g.
# https://<ref>.supabase.co/auth/v1. Service-role keys (iss "supabase") are
# accepted regardless.
# SUPABASE_JWT_ISSUER=

# Local development only. Without SUPABASE_JWT_SECRET the service refuses to
# start (fail closed); set this to true to run it open on your machine, e.g.
# for `make run` / `npm run dev:all`. Never set it in production.
# COMPILE_AUTH_DISABLED=true

# Better Stack log shipping (production only). The vector container in
# deployments/docker-compose.prod.yml forwards this service's logs there.
# BETTER_STACK_SOURCE_TOKEN=
# BETTER_STACK_INGESTING_HOST=
