# Auth. /compile and /synctex accept only tokens whose role is "authenticated"
# (a user's access token) or "service_role" (the service-role key / app-minted
# server tokens); the public anon key is rejected. At least one of
# SUPABASE_JWT_SECRET / SUPABASE_URL is required, or the service refuses to
# start (unless COMPILE_AUTH_DISABLED=true below).
#
# Legacy JWT secret: verifies HS256 tokens. Keep it set even after the project
# moves to asymmetric signing keys, since the legacy service-role key and the
# tokens lib/compile/credential.ts mints are HS256.
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Supabase project URL: enables ES256/RS256 tokens (asymmetric JWT signing
# keys), verified against <SUPABASE_URL>/auth/v1/.well-known/jwks.json by the
# token's kid. Keys are cached for 10 min; an unknown kid refetches at most
# once per 30 s; a failed fetch keeps the last good set for up to 24 h (an
# unresolvable kid during a JWKS outage gets 503, not 401). Must be https
# (http only for localhost); redirects are not followed.
# SUPABASE_URL=https://<ref>.supabase.co
# Optional: explicit JWKS URL instead of the one derived from SUPABASE_URL.
# SUPABASE_JWKS_URL=

# Optional: pin user tokens to one Supabase project, e.g.
# https://<ref>.supabase.co/auth/v1. Service-role keys (iss "supabase") are
# accepted regardless.
# SUPABASE_JWT_ISSUER=

# Local development only. Without SUPABASE_JWT_SECRET or SUPABASE_URL the service refuses to
# start (fail closed); set this to true to run it open on your machine, e.g.
# for `make run` / `npm run dev:all`. Never set it in production.
# COMPILE_AUTH_DISABLED=true

# Better Stack log shipping (production only). The vector container in
# deployments/docker-compose.prod.yml forwards this service's logs there.
# BETTER_STACK_SOURCE_TOKEN=
# BETTER_STACK_INGESTING_HOST=

# PostHog compile telemetry (optional): one `compile_service_result` event per
# request with engine, exit code, duration, queue time, cache hit, the first
# TeX error line and an excerpt, timeouts and refusals. API key = the PostHog
# project token (the same public token the apps use). Unset = off.
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
