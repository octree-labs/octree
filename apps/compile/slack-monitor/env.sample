# Slack Bot Token (xoxb-...)
# Get this from https://api.slack.com/apps > Your App > OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Channel to send health reports to (e.g., #server-health or channel ID)
SLACK_CHANNEL=#server-health

# Check interval in seconds (default: 3600 = 1 hour)
CHECK_INTERVAL=3600


# Health endpoint to monitor (e.g., http://<server-ip>/health)
HEALTH_URL=http://your-server/health
